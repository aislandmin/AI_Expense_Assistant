# PostgreSQL connection string used by Prisma.
# Example local database name: ai_expense_assistant
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_expense_assistant"

# JWT signing secret for the ai_expense_auth httpOnly cookie.
# Use a long random value in production.
JWT_SECRET="replace-with-a-secure-secret"

# Frontend origin allowed by CORS.
CLIENT_URL="http://localhost:5173"

# API server port.
PORT=5000

# Optional OpenAI settings.
# When OPENAI_API_KEY is empty, Quick Add uses deterministic fallback parsing.
OPENAI_API_KEY="your-openai-key"
OPENAI_MODEL="gpt-4o-mini"
